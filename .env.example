# Puerto del servidor
PORT=4000

# PostgreSQL (Supabase, Neon o Railway)
DATABASE_URL="postgresql://usuario:contraseña@host:5432/base?schema=public"

# JWT — usa una cadena larga y aleatoria
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:3000

# Supabase Storage
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=servicios
